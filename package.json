{
  "name": "oshxonachi",
  "version": "1.0.0",
  "description": "Restoran Boshqaruv Tizimi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "open": "^8.4.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.oshxona.app",
    "productName": "Oshxona Boshqaruv Tizimi",
    "win": {
      "target": "nsis"
    },
    "files": [
      "server.js",
      "main.js",
      "package.json",
      "public/**/*",
      "config/**/*",
      "controllers/**/*",
      "routes/**/*",
      "sockets/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
